.DS_Store
DerivedData/
.build/
*.xcuserstate
xcuserdata/

# Local release credentials, runner state, and generated assets
.local-ci/
apple/.bundle/
apple/build/
apple/vendor/
/apple/fastlane/report.xml
/.bundle/
/vendor/
/fastlane/.env*
!/fastlane/.env.local.example
/fastlane/report.xml
/fastlane/Preview.html
/fastlane/README.md
/fastlane/android/metadata/*/images/phoneScreenshots/
*.p8
*.ipa
*.dSYM.zip

# Generated assets stay local; track build scripts and schemas only.
/temp/
/build/**
!/build/**/
!/build/**/*.py
!/build/**/*.sh
!/build/*/schema.sql
!/build/hadith/data/supplications.json

# Python
__pycache__

# Semantic search credentials and generated corpus/batch state
backend/.env*
!backend/.env.example
backend/.venv/
backend/work/
apple/Muntathir/Resources/SemanticSearchConfiguration.plist

backend/api/node_modules/

!/build/library/README.md
.idea/

# Agent skill scratch output (e.g. play-policy-insights)
.scratch/

# Sermon sources and offline reader builder
!/build/sermons/**
/build/sermons/**/__pycache__/

# Telegram bot secrets and build output
/telegram/.env*
/telegram/node_modules/
