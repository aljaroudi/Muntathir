require File.expand_path("ios/support", File.dirname(configfile_path))

project(File.join(MuntathirRelease::ROOT, "Muntathir.xcodeproj"))
scheme("Muntathir")
configuration("Debug")
devices(MuntathirRelease::PREVIEW_DEVICES)
ios_version(MuntathirRelease.capture_runtime(MuntathirRelease::PREVIEW_DEVICES.first))
languages(MuntathirRelease::LOCALES)
only_testing(["MuntathirUITests/MarketingScreenshotTests"])
output_directory(File.join(MuntathirRelease::ROOT, "build/marketing/raw"))
buildlog_path(File.join(MuntathirRelease::ROOT, "build/logs/snapshot"))
derived_data_path(File.join(MuntathirRelease::ROOT, "build/marketing/DerivedData"))
skip_open_summary(true)
concurrent_simulators(false)
xcargs("-parallel-testing-enabled NO")
number_of_retries(0)
stop_after_first_error(true)
clear_previous_screenshots(false)
reinstall_app(true)
app_identifier("com.aljaroudi.Muntathir")
override_status_bar(true)
override_status_bar_arguments("--time 9:41 --dataNetwork wifi --wifiMode active --wifiBars 3 --batteryState charged --batteryLevel 100")
