require "tmpdir"
require "dotenv"
require "plist"
require "spaceship"
Dotenv.load(ENV.fetch("MUNTATHIR_FASTLANE_ENV_FILE", File.expand_path("~/.config/muntathir/fastlane.env")))
require_relative "ios/support"

default_platform(:ios)

platform :ios do
  desc "Validate local metadata and release lanes without Apple access"
  lane :check do |options|
    sh("python3", File.join(MuntathirRelease::ROOT, "scripts/check_localizations.py"))
    flags = options[:skip_media] ? ["--skip-media"] : []
    sh("bundle", "exec", "ruby", File.join(__dir__, "ios/check.rb"), *flags)
  end

  desc "Run unit and UI regression tests, excluding marketing captures"
  lane :tests do |options|
    sh("python3", File.join(MuntathirRelease::ROOT, "scripts/check_localizations.py"))
    run_tests(project: File.join(MuntathirRelease::ROOT, "Muntathir.xcodeproj"), scheme: "Muntathir",
              destination: MuntathirRelease.test_destinations(include_ipad: options[:include_ipad] == true),
              skip_testing: ["MuntathirUITests/MarketingScreenshotTests", "MuntathirUITests/QuranScreenshotRefreshTests"],
              parallel_testing: false, disable_concurrent_testing: true, skip_detect_devices: true, skip_slack: true, fail_build: true,
              output_directory: File.join(MuntathirRelease::ROOT, "build/tests"), buildlog_path: File.join(MuntathirRelease::ROOT, "build/logs/tests"),
              derived_data_path: File.join(MuntathirRelease::ROOT, "build/DerivedData"))
    MuntathirRelease.cleanup_build_artifacts!(paths: ["build/DerivedData"])
  end

  desc "Remove disposable local build caches; keep IPAs, symbols, media and diagnostics"
  lane :cleanup do
    MuntathirRelease.cleanup_build_artifacts!
  end

  desc "Capture localized iPhone, iPad and Duo screenshots"
  lane :screenshots do |options|
    sh("bundle", "exec", "ruby", File.join(__dir__, "ios/screenshots.rb"), options[:devices].to_s, options[:languages].to_s,
       options.fetch(:workers) { MuntathirRelease.default_screenshot_workers }.to_s)
  end

  desc "Style raw screenshots with frames, backgrounds and localized headlines"
  lane :style do |options|
    sh("bundle", "exec", "ruby", File.join(__dir__, "ios/style.rb"), options[:languages].to_s)
  end

  desc "Record continuous sunrise-to-sunset simulator previews in every store locale"
  lane :previews do |options|
    sh("bundle", "exec", "ruby", File.join(__dir__, "ios/previews.rb"), options[:devices].to_s)
  end

  desc "Capture required localized Apple Watch store screenshots"
  lane :watch_screenshots do |options|
    sh("bundle", "exec", "ruby", File.join(__dir__, "ios/watch_screenshots.rb"), options[:languages].to_s)
  end

  desc "Export Arabic/English website screenshots as WebP and previews as WebM"
  lane :web_media do
    sh("bundle", "exec", "ruby", File.join(__dir__, "ios/web_media.rb"))
  end

  desc "Generate all screenshots, App Preview videos and website media locally"
  lane :marketing do
    refresh_screenshots
    previews
    web_media
  end

  private_lane :credentials do
    %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_PATH].each do |name|
      UI.user_error!("Missing #{name}; configure ~/.config/muntathir/fastlane.env") if ENV[name].to_s.strip.empty?
    end
    path = File.expand_path(ENV.fetch("ASC_KEY_PATH"))
    UI.user_error!("App Store Connect key does not exist: #{path}") unless File.file?(path)
    Spaceship::ConnectAPI::App.prepend(MuntathirRelease::EditableReviewDraft)
    app_store_connect_api_key(key_id: ENV.fetch("ASC_KEY_ID"), issuer_id: ENV.fetch("ASC_ISSUER_ID"), key_filepath: path, in_house: false)
  end

  private_lane :refresh_screenshots do
    started = Time.now
    sh("bundle", "exec", "ruby", File.join(__dir__, "ios/refresh_screenshots.rb"))
    style
    MuntathirRelease.validate_media!(since: started)
  end

  private_lane :release_context do |options|
    credentials
    app = Spaceship::ConnectAPI::App.find("com.aljaroudi.Muntathir")
    UI.user_error!("Muntathir not found in App Store Connect") unless app&.id == "6824304362"
    version = MuntathirRelease.project_version
    draft = app.get_edit_app_store_version(platform: "IOS") if options.fetch(:app_store)
    MuntathirRelease.validate_draft!(draft, version) if options.fetch(:app_store)
    config = MuntathirRelease.review_config
    encryption = MuntathirRelease.compliance!(config)
    context = { app: app, version: version, draft: draft, config: config, encryption: encryption }
    if options.fetch(:app_store)
      if app.get_in_progress_review_submission(platform: "IOS") || app.get_ready_review_submission(platform: "IOS", includes: "items")&.items&.any?
        UI.user_error!("Resolve the existing App Review submission in App Store Connect before uploading a new build.")
      end
      live = app.get_live_app_store_version(platform: "IOS")
      draft_localizations = draft.get_app_store_version_localizations
      live_localizations = live&.get_app_store_version_localizations || []
      notes = MuntathirRelease.release_notes(version).slice(*MuntathirRelease::LOCALES)
      context[:release_notes] = notes
      MuntathirRelease.validate_notes_changed!(notes, live_localizations, "What's New", force: options[:force])

      app_info = app.fetch_edit_app_info || app.fetch_live_app_info
      info_localizations = app_info&.get_app_info_localizations || []
      MuntathirRelease::LOCALES.each do |locale|
        support = config.dig("support_url", locale) || MuntathirRelease.metadata(locale, "support_url") ||
                  draft_localizations.find { |entry| entry.locale == locale }&.support_url ||
                  live_localizations.find { |entry| entry.locale == locale }&.support_url
        privacy = config.dig("privacy_url", locale) || MuntathirRelease.metadata(locale, "privacy_url") ||
                  info_localizations.find { |entry| entry.locale == locale }&.privacy_policy_url
        MuntathirRelease.validate_url!(support, "#{locale} support_url")
        MuntathirRelease.validate_url!(privacy, "#{locale} privacy_url")
      end
      review = MuntathirRelease.optional_model(Spaceship::ConnectAPI.get_app_store_review_detail(app_store_version_id: draft.id))
      values = review ? { "first_name" => review.contact_first_name, "last_name" => review.contact_last_name,
                          "phone_number" => review.contact_phone, "email_address" => review.contact_email } : {}
      MuntathirRelease.required!(values.merge(config.fetch("app_review_information", {})), %w[first_name last_name phone_number email_address], "App Review contact")
      MuntathirRelease.required!({ "copyright" => config["copyright"] || MuntathirRelease.metadata("", "copyright") || draft.copyright },
                                ["copyright"], "App Store copyright")
    else
      group = app.get_beta_groups.find { |candidate| candidate.name == "Public" && !candidate.is_internal_group }
      UI.user_error!("Create an external TestFlight group named Public in App Store Connect") unless group
      review = MuntathirRelease.optional_model(Spaceship::ConnectAPI.get_beta_app_review_detail(filter: { app: app.id }))
      values = review ? { "contact_first_name" => review.contact_first_name, "contact_last_name" => review.contact_last_name,
                          "contact_phone" => review.contact_phone, "contact_email" => review.contact_email } : {}
      MuntathirRelease.required!(values.merge(config.fetch("beta_app_review_info", {})), %w[contact_first_name contact_last_name contact_phone contact_email], "Beta App Review contact")
      localizations = app.get_beta_app_localizations
      feedback = config["beta_app_feedback_email"] || localizations.find { |entry| !entry.feedback_email.to_s.strip.empty? }&.feedback_email
      MuntathirRelease.required!({ "feedback_email" => feedback }, ["feedback_email"], "TestFlight")

      notes = MuntathirRelease.beta_notes
      latest = group.fetch_builds.max_by { |build| build.uploaded_date.to_s }
      previous = latest&.get_beta_build_localizations || []
      MuntathirRelease.validate_notes_changed!(notes, previous, "What to Test", force: options[:force])
      context[:beta_notes] = notes
      context[:feedback_email] = feedback
    end
    context
  end

  private_lane :assert_current_draft do |context|
    draft = context.fetch(:app).get_edit_app_store_version(platform: "IOS")
    MuntathirRelease.validate_draft!(draft, context.fetch(:version), expected_id: context.fetch(:draft).id)
    draft
  end

  private_lane :archive_and_upload do |context|
    version = context.fetch(:version)
    app_id = context.fetch(:app).id
    provisioning = ["-allowProvisioningUpdates", "-authenticationKeyPath", File.expand_path(ENV.fetch("ASC_KEY_PATH")),
                    "-authenticationKeyID", ENV.fetch("ASC_KEY_ID"), "-authenticationKeyIssuerID", ENV.fetch("ASC_ISSUER_ID")]
    output = File.join(MuntathirRelease::ROOT, "build")
    archive = File.join(output, "Muntathir-#{version}-#{Time.now.utc.strftime('%Y%m%dT%H%M%S')}.xcarchive")
    export = File.join(output, "ReleaseExportOptions.plist")
    # Xcode's native archiver supports the Xcode 27 JSON project format.
    sh("xcodebuild", "-quiet", "-project", File.join(MuntathirRelease::ROOT, "Muntathir.xcodeproj"), "-scheme", "Muntathir",
       "-configuration", "Release", "-destination", "generic/platform=iOS", "-archivePath", archive,
       "-derivedDataPath", File.join(output, "ArchiveDerivedData"),
       "SEMANTIC_SEARCH_URL=https://search.xn--pgbou4cf.com/v1/search", *provisioning, "archive")
    archived_app = File.join(archive, "Products", "Applications", "Muntathir.app")
    sh("python3", File.join(MuntathirRelease::ROOT, "AssetPacks/assets.py"), "check-bundle", archived_app)
    bundle = Plist.parse_xml(MuntathirRelease.run!("plutil", "-convert", "xml1", "-o", "-", File.join(archived_app, "Info.plist")))
    unless bundle.fetch("CFBundleShortVersionString") == version && bundle.fetch("CFBundleVersion").to_s == "1"
      UI.user_error!("Archive must contain Muntathir version #{version} with the project build number 1")
    end

    File.write(export, { "method" => "app-store-connect", "destination" => "upload", "teamID" => "5VGKP2QV6H",
                         "signingStyle" => "automatic", "manageAppVersionAndBuildNumber" => true,
                         "testFlightInternalTestingOnly" => false, "uploadSymbols" => true }.to_plist)
    assert_current_draft(context) if context[:draft]
    existing_ids = MuntathirRelease.build_uploads(app_id, version).map { |upload| upload.fetch("id") }
    UI.header("Uploading #{version} with Xcode-managed build numbering")
    begin
      sh("xcodebuild", "-quiet", "-exportArchive", "-archivePath", archive, "-exportPath", output,
         "-exportOptionsPlist", export, *provisioning)
      build = MuntathirRelease.wait_for_uploaded_build(app_id, version, existing_ids)
    rescue StandardError
      UI.error("Check Build Uploads in App Store Connect before retrying. Archive retained at #{archive}")
      raise
    end
    MuntathirRelease.retire_archive!(archive, symbols: File.join(output, "symbols", "#{build.app_version}-#{build.version}"))
    MuntathirRelease.cleanup_build_artifacts!(paths: ["build/ArchiveDerivedData"])
    UI.success("Processed #{build.app_version} (#{build.version})")
    build
  end

  private_lane :prepare_release do |options|
    check(skip_media: !options.fetch(:app_store))
    context = release_context(app_store: options.fetch(:app_store), force: options[:force].to_s == "true")
    sh("python3", File.join(__dir__, "../build/build.py"), "--assets-only")
    tests(include_ipad: options.fetch(:app_store)) unless options[:skip_tests].to_s == "true"
    if options.fetch(:app_store)
      if options[:skip_screenshots].to_s == "true"
        MuntathirRelease.validate_media!
      else
        refresh_screenshots
      end
    end
    context[:asset_packs] = MuntathirRelease.sync_asset_packs!
    context
  end

  desc "Test on iPhone and submit a new build to TestFlight Public"
  lane :testflight_public do |options|
    MuntathirRelease.with_release_lock do
      context = prepare_release(app_store: false, force: options[:force], skip_tests: options[:skip_tests])
      build = archive_and_upload(context)
      config = context.fetch(:config)
      notes = context.fetch(:beta_notes)
      beta_app_info = MuntathirRelease::LOCALES.to_h do |locale|
        [locale, { description: config.dig("beta_app_description", locale) || MuntathirRelease.metadata(locale, "description"),
                   feedback_email: context.fetch(:feedback_email) }]
      end
      upload_to_testflight(apple_id: context.fetch(:app).id, app_version: build.app_version, build_number: build.version,
                           app_platform: "ios", distribute_only: true, skip_waiting_for_build_processing: false,
                           wait_processing_timeout_duration: 60,
                           changelog: notes.fetch("en-US"), localized_build_info: notes.transform_values { |text| { whats_new: text } },
                           beta_app_review_info: config["beta_app_review_info"], localized_app_info: beta_app_info,
                           uses_non_exempt_encryption: context.fetch(:encryption), distribute_external: true,
                           groups: ["Public"], submit_beta_review: true, notify_external_testers: true)
      context.fetch(:asset_packs).each do |pack|
        next if pack[:version_id] == pack[:external_version_id]

        UI.important("In TestFlight → Asset Packs, submit #{pack[:name]} version #{pack[:version]} for external testing if it is not already in review.")
      end
      UI.success("Public Beta App Review requested for #{build.app_version} (#{build.version}). Tester availability depends on Apple approval.")
    end
  end

  desc "Test on iPhone and iPad, refresh the listing, and submit the TestFlight build for automatic App Store release"
  lane :app_store do |options|
    MuntathirRelease.with_release_lock do
      context = prepare_release(app_store: true, force: options[:force], skip_tests: options[:skip_tests],
                                skip_screenshots: options[:skip_screenshots])
      build = MuntathirRelease.existing_valid_build(context.fetch(:app).id, context.fetch(:version), build_number: options[:build_number])
      draft = assert_current_draft(context)
      app_identifier = context.fetch(:app).bundle_id
      store_options = { app_identifier: app_identifier, platform: "ios", app_version: build.app_version,
                        skip_app_version_update: true, skip_binary_upload: true, force: true,
                        reject_if_possible: false, run_precheck_before_submit: false }
      config = context.fetch(:config)
      metadata = config.slice("app_review_information", "support_url", "privacy_url", "copyright").reject { |_, value| value.nil? || value.empty? }.transform_keys(&:to_sym)
      Dir.mktmpdir("app-store-screenshots-") do |upload_gallery|
        MuntathirRelease::LOCALES.each do |locale|
          File.symlink(File.join(MuntathirRelease::ROOT, "build/marketing/store", locale), File.join(upload_gallery, locale))
        end
        upload_to_app_store(**store_options, **metadata, metadata_path: File.expand_path("ios/metadata", __dir__),
                            release_notes: context.fetch(:release_notes), screenshots_path: upload_gallery, overwrite_screenshots: true,
                            automatic_release: draft.release_type == "AFTER_APPROVAL" ? nil : true, submit_for_review: false)
      end

      draft = assert_current_draft(context)
      MuntathirRelease.sync_creative_assets!(draft.get_app_store_version_localizations)

      unless draft.release_type == "AFTER_APPROVAL"
        UI.user_error!("Set automatic release after approval for this draft in App Store Connect.")
      end
      unless precheck(app_identifier: app_identifier, include_in_app_purchases: false, platform: "ios")
        UI.user_error!("App Store metadata precheck failed. Check the draft before retrying.")
      end
      assert_current_draft(context)
      MuntathirRelease.review_pack_versions = context.fetch(:asset_packs).reject { |pack| pack[:version_id] == pack[:store_version_id] }.map { |pack| pack.fetch(:version_id) }
      Spaceship::ConnectAPI::ReviewSubmission.prepend(MuntathirRelease::ReviewAssetPacks)
      upload_to_app_store(**store_options, build_number: build.version, skip_metadata: true, skip_screenshots: true,
                          submission_information: config.fetch("submission_information"), submit_for_review: true)
      UI.success("App Review submitted for #{build.app_version} (#{build.version}).")
    end
  end
end

platform :android do
  %i[screenshots style].each do |operation|
    lane operation do |options|
      sh("bundle", "exec", "ruby", File.join(__dir__, "android/gallery.rb"), operation.to_s, options[:languages].to_s)
    end
  end

  desc "Build and publish a signed AAB to Google Play internal testing"
  lane :internal do |options|
    root = File.expand_path("..", __dir__)
    credentials = File.expand_path(ENV.fetch("SUPPLY_JSON_KEY", "~/.android/muntathir-upload/play-publisher.json"), root)
    UI.user_error!("Set SUPPLY_JSON_KEY to a readable Google credentials JSON file") unless
      File.file?(credentials) && File.readable?(credentials)

    if options[:aab]
      bundle = File.expand_path(options[:aab].to_s, root)
    else
      android = File.join(root, "android")
      sh("just", "--justfile", File.join(root, "justfile"), "android-packs")
      sh(File.join(android, "gradlew"), "-p", android, ":app:bundleRelease", "-PrequireUploadSigning=true")
      bundle = File.join(android, "app/build/outputs/bundle/release/app-release.aab")
    end
    UI.user_error!("Expected a signed AAB at #{bundle}") unless File.file?(bundle) && File.extname(bundle) == ".aab"

    upload_to_play_store(
      package_name: "com.aljaroudi.muntathir",
      json_key: credentials,
      aab: bundle,
      track: "internal",
      release_status: options[:draft] == true ? "draft" : "completed",
      validate_only: options[:validate_only] == true,
      skip_upload_apk: true,
      skip_upload_aab: false,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end
