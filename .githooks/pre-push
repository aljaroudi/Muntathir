#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
if ! command -v xcodebuild >/dev/null 2>&1; then
    echo "Xcode is required. Install Xcode and select it with xcode-select." >&2
    exit 1
fi

destination=${TEST_DESTINATION:-}
if [ -z "$destination" ]; then
    if ! destinations=$(xcodebuild -project Muntathir.xcodeproj -scheme Muntathir -showdestinations); then
        echo "Unable to list test destinations. Check Xcode setup with xcode-select -p." >&2
        exit 1
    fi
    simulator_id=$(printf '%s\n' "$destinations" | awk '
        /platform:iOS Simulator,/ && /name:iPhone/ && !/error:/ {
            for (i = 1; i <= NF; i++) {
                if ($i ~ /^id:/) {
                    sub(/^id:/, "", $i)
                    sub(/,$/, "", $i)
                    print $i
                    exit
                }
            }
        }')
    if [ -z "$simulator_id" ]; then
        echo "No compatible iPhone simulator. Install an iOS runtime in Xcode and create an iPhone simulator, or set TEST_DESTINATION." >&2
        exit 1
    fi
    destination="platform=iOS Simulator,id=$simulator_id"
fi

echo "Running MuntathirTests on $destination"
if ! xcodebuild test -project Muntathir.xcodeproj -scheme Muntathir \
    -destination "$destination" -only-testing:MuntathirTests; then
    echo "Push blocked: MuntathirTests failed. Fix the test or build errors above, then retry." >&2
    exit 1
fi
