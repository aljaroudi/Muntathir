    "Choose a city or use your device location to calculate prayer times and Qibla." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر مدينة أو استخدم موقع جهازك لحساب أوقات الصلاة واتجاه القبلة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle eine Stadt oder verwende den Gerätestandort, um Gebetszeiten und Qibla zu berechnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a city or use your device location to calculate prayer times and Qibla."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige una ciudad o usa la ubicación del dispositivo para calcular los horarios de oración y la alquibla."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای محاسبهٔ اوقات نماز و قبله، شهری را انتخاب کنید یا از مکان دستگاه استفاده کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez une ville ou utilisez la position de l’appareil pour calculer les horaires de prière et la Qibla."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih kota atau gunakan lokasi perangkat untuk menghitung waktu salat dan kiblat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli una città o usa la posizione del dispositivo per calcolare gli orari di preghiera e la Qibla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "都市を選択するか、デバイスの位置情報を使って礼拝時刻とキブラを計算します。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih bandar atau gunakan lokasi peranti untuk mengira waktu solat dan kiblat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите город или используйте геопозицию устройства для расчёта времени намаза и киблы."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Namaz vakitlerini ve kıbleyi hesaplamak için bir şehir seçin veya aygıtınızın konumunu kullanın."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نماز کے اوقات اور قبلہ معلوم کرنے کے لیے شہر منتخب کریں یا آلے کا مقام استعمال کریں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择城市或使用设备位置，以计算礼拜时间和朝向。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇城市或使用裝置位置，以計算禮拜時間和朝向。"
          }
        }
      }
    },
