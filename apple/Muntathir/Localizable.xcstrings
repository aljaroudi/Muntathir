    "Imsak is a precaution before calculated Fajr." : {
      "comment" : "A description of the Imsak setting.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإمساك يحتاط لدقة وقت صلاة الفجر"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imsak ist eine Vorsichtszeit vor dem berechneten Fajr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imsak is a precaution before calculated Fajr."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Imsak es una precaución antes del Fajr calculado."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "امساک احتیاطی پیش از وقت محاسبه‌شدهٔ صبح است."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
