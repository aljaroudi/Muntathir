      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إخفاء الوقت لا يغيّر إعداد الإشعار الخاص به."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Ausblenden einer Zeit ändert ihre Benachrichtigungseinstellung nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiding a time does not change its notification setting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocultar un horario no cambia sus ajustes de notificación."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پنهان‌کردن یک وقت، تنظیم اعلان آن را تغییر نمی‌دهد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masquer un horaire ne modifie pas son réglage de notification."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menyembunyikan waktu tidak mengubah pengaturan notifikasinya."
          }
        },
