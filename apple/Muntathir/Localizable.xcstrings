    "Calculated dates are not sighting confirmations." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التواريخ المحسوبة ليست تأكيدًا للرؤية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berechnete Daten sind keine bestätigten Mondsichtungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calculated dates are not sighting confirmations."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fechas calculadas no confirman el avistamiento lunar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تاریخ‌های محاسبه‌شده تأیید رؤیت هلال نیستند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les dates calculées ne confirment pas l’observation du croissant."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanggal hasil perhitungan bukan konfirmasi rukyat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le date calcolate non confermano l’avvistamento lunare."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarikh yang dikira bukan pengesahan cerapan anak bulan."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Расчётные даты не являются подтверждением наблюдения луны."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesaplanan tarihler hilal gözlemi onayı değildir."
