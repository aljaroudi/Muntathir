    "Without a published announcement, dates use the system calendar. Adjust individual months in Calendar." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند عدم وجود إعلان منشور، تتبع التواريخ تقويم النظام. يمكنك تعديل كل شهر على حدة في التقويم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne veröffentlichte Bekanntgabe gilt der Systemkalender. Passe einzelne Monate im Kalender an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without a published announcement, dates use the system calendar. Adjust individual months in Calendar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin un anuncio publicado, las fechas usan el calendario del sistema. Ajusta cada mes en Calendario."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بدون اطلاعیهٔ منتشرشده، تاریخ‌ها از تقویم سیستم پیروی می‌کنند. ماه‌ها را جداگانه در تقویم تنظیم کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans annonce publiée, les dates suivent le calendrier système. Ajustez chaque mois dans Calendrier."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanpa pengumuman yang diterbitkan, tanggal mengikuti kalender sistem. Sesuaikan tiap bulan di Kalender."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza un annuncio pubblicato, le date seguono il calendario di sistema. Regola i singoli mesi in Calendario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "発表がない場合は、システムのカレンダーに従います。カレンダーで各月を調整できます。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanpa pengumuman diterbitkan, tarikh mengikut kalendar sistem. Laraskan setiap bulan dalam Kalendar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без опубликованного объявления даты следуют системному календарю. Корректируйте отдельные месяцы в календаре."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yayımlanmış duyuru yoksa tarihler sistem takvimini kullanır. Takvim’de ayları ayrı ayrı ayarlayın."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شائع شدہ اعلان نہ ہو تو تاریخیں نظام کی تقویم کے مطابق ہوتی ہیں۔ تقویم میں ہر مہینہ الگ درست کریں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有已发布的公告时，日期使用系统日历。可在日历中调整各个月份。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有已發佈的公告時，日期使用系統行事曆。可在行事曆中調整各個月份。"
          }
        }
      }
    },
    "Your change was not saved. Please try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُحفظ التغيير. يرجى المحاولة مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Änderung wurde nicht gespeichert. Bitte versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your change was not saved. Please try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cambio no se guardó. Vuelve a intentarlo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغییر شما ذخیره نشد. لطفاً دوباره تلاش کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre modification n’a pas été enregistrée. Veuillez réessayer."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perubahan Anda tidak disimpan. Silakan coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La modifica non è stata salvata. Riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "変更は保存されませんでした。もう一度お試しください。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perubahan anda tidak disimpan. Sila cuba lagi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изменение не сохранено. Повторите попытку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Değişikliğiniz kaydedilmedi. Lütfen tekrar deneyin."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کی تبدیلی محفوظ نہیں ہوئی۔ براہ کرم دوبارہ کوشش کریں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的更改未保存。请重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的更改未儲存。請再試一次。"
          }
        }
      }
    },
    "Your note is still here. Please try saving again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ملاحظتك لا تزال هنا. يرجى محاولة الحفظ مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Notiz ist noch vorhanden. Versuche erneut, sie zu speichern."
