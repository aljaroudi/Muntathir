    "Allow location access and Precise Location in Settings to find Qibla." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح بالوصول إلى الموقع والموقع الدقيق في الإعدادات لتحديد القبلة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube den Standortzugriff und den genauen Standort in den Einstellungen, um die Qibla zu finden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow location access and Precise Location in Settings to find Qibla."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite el acceso a la ubicación y la ubicación precisa en Ajustes para encontrar la alquibla."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای یافتن قبله، دسترسی به موقعیت مکانی و موقعیت دقیق را در تنظیمات فعال کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez l’accès à la position et la position exacte dans Réglages pour trouver la Qibla."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izinkan akses lokasi dan Lokasi Presisi di Pengaturan untuk menemukan kiblat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti l’accesso alla posizione e la posizione esatta nelle Impostazioni per trovare la Qibla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キブラを確認するには、設定で位置情報へのアクセスと「正確な位置情報」を許可してください。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benarkan akses lokasi dan Lokasi Tepat dalam Tetapan untuk mencari kiblat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешите доступ к геопозиции и точную геопозицию в настройках, чтобы найти киблу."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kıbleyi bulmak için Ayarlar’da konum erişimine ve Tam Konum’a izin verin."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قبلہ تلاش کرنے کے لیے ترتیبات میں مقام تک رسائی اور درست مقام کی اجازت دیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在设置中允许位置访问和精确位置，以确定朝向。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在設定中允許位置存取和精確位置，以確定朝向。"
          }
        }
      }
    },
    "Allow Time Sensitive alerts in Settings and Focus. Sound follows Silent mode and your Ringtone and Alerts volume." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح بالإشعارات الحساسة للوقت في الإعدادات والتركيز. يخضع الصوت للنمط الصامت ومستوى صوت الرنين والتنبيهات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube zeitkritische Hinweise in Einstellungen und Fokus. Der Ton richtet sich nach Stummmodus und Klingel- und Hinweislautstärke."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow Time Sensitive alerts in Settings and Focus. Sound follows Silent mode and your Ringtone and Alerts volume."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite avisos importantes en Ajustes y Concentración. El sonido respeta el modo Silencio y el volumen de tonos y avisos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هشدارهای حساس به زمان را در تنظیمات و تمرکز مجاز کنید. صدا تابع حالت بی‌صدا و بلندی صدای زنگ و هشدار است."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez les notifications urgentes dans Réglages et Concentration. Le son respecte le mode Silence et le volume Sonnerie et alertes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izinkan peringatan peka waktu di Pengaturan dan Fokus. Suara mengikuti mode Hening dan volume Nada Dering dan Peringatan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti gli avvisi urgenti in Impostazioni e Full immersion. L’audio segue la modalità Silenzioso e il volume Suoneria e avvisi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定と集中モードで即時通知を許可してください。サウンドは消音モードと着信音・通知音の音量に従います。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benarkan amaran peka masa dalam Tetapan dan Fokus. Bunyi mengikut mod Senyap dan kelantangan Nada Dering dan Amaran."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешите срочные уведомления в Настройках и Фокусировании. Звук зависит от бесшумного режима и громкости звонка и уведомлений."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayarlar ve Odak içinde Zamana Duyarlı uyarılara izin verin. Ses, Sessiz moda ve Zil Sesi ve Uyarılar düzeyine uyar."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ترتیبات اور فوکس میں وقت کے لحاظ سے حساس انتباہات کی اجازت دیں۔ آواز خاموش موڈ اور رنگ ٹون اور انتباہات کی آواز کے مطابق ہوگی۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在设置和专注模式中允许时效性通知。声音遵循静音模式以及铃声和提醒音量。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在設定和專注模式中允許即時通知。聲音遵循靜音模式以及鈴聲和提示音量。"
          }
        }
      }
    },
