    "Settings sync through iCloud when available. Live GPS and notification permissions stay on this device." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتزامن الإعدادات عبر iCloud عند توفره. يبقى الموقع المباشر وأذونات التنبيهات على هذا الجهاز."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einstellungen werden über iCloud synchronisiert, wenn verfügbar. GPS-Standort und Mitteilungsberechtigungen bleiben auf diesem Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settings sync through iCloud when available. Live GPS and notification permissions stay on this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los ajustes se sincronizan mediante iCloud cuando está disponible. El GPS y los permisos de notificación permanecen en este dispositivo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "در صورت دسترسی، تنظیمات با iCloud همگام می‌شوند. مکان GPS و مجوزهای اعلان روی همین دستگاه می‌مانند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les réglages se synchronisent via iCloud si disponible. La position GPS et les autorisations de notification restent sur cet appareil."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengaturan diselaraskan melalui iCloud jika tersedia. Lokasi GPS dan izin notifikasi tetap di perangkat ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le impostazioni si sincronizzano tramite iCloud quando disponibile. Posizione GPS e autorizzazioni di notifica rimangono su questo dispositivo."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seting disegerakkan melalui iCloud apabila tersedia. Lokasi GPS dan kebenaran pemberitahuan kekal pada peranti ini."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройки синхронизируются через iCloud при его доступности. Геопозиция GPS и разрешения на уведомления остаются на этом устройстве."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayarlar, kullanılabildiğinde iCloud üzerinden eşzamanlanır. GPS konumu ve bildirim izinleri bu aygıtta kalır."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دستیاب ہونے پر ترتیبات iCloud کے ذریعے ہم وقت ہوتی ہیں۔ GPS مقام اور اطلاعات کی اجازتیں اسی آلے پر رہتی ہیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置会在 iCloud 可用时同步。GPS 位置和通知权限仅保留在此设备上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定會在 iCloud 可用時同步。GPS 位置和通知權限僅保留在此裝置上。"
          }
        }
      }
    },
