    "Bookmark a ruling to find it again in Saved." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف إشارة مرجعية للحكم لتجده لاحقًا في المحفوظات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setze ein Lesezeichen für einen Rechtsspruch, um ihn unter Gespeichert wiederzufinden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bookmark a ruling to find it again in Saved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade un marcador a un dictamen para encontrarlo en Guardados."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای یافتن دوباره حکم در ذخیره‌شده‌ها، آن را نشانک‌گذاری کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez un signet à un avis juridique pour le retrouver dans les éléments enregistrés."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tandai hukum untuk menemukannya kembali di Tersimpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi un segnalibro a un responso per ritrovarlo tra gli elementi salvati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "法的見解をブックマークすると、保存済みから再び開けます。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tandakan hukum untuk menemuinya semula dalam Disimpan."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте решение в закладки, чтобы найти его в сохранённом."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir hükmü Kaydedilenler’de tekrar bulmak için yer imi ekleyin."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حکم کو محفوظ کردہ میں دوبارہ تلاش کرنے کے لیے بک مارک کریں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为教法判例添加书签，以便在已保存中再次找到。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為教法判例加入書籤，以便在已儲存中再次找到。"
          }
        }
      }
    },
