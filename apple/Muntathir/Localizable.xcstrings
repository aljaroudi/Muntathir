    "Place search is unavailable. Try again when online." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "البحث عن الأماكن غير متاح. حاول مجددًا عند الاتصال بالإنترنت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ortssuche nicht verfügbar. Versuche es mit Internetverbindung erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Place search is unavailable. Try again when online."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La búsqueda de lugares no está disponible. Inténtalo cuando tengas conexión."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جست‌وجوی مکان در دسترس نیست. پس از اتصال به اینترنت دوباره تلاش کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recherche de lieux indisponible. Réessayez avec une connexion Internet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pencarian tempat tidak tersedia. Coba lagi saat terhubung ke internet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ricerca dei luoghi non è disponibile. Riprova quando sei online."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "場所の検索を利用できません。インターネットに接続してから再試行してください。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carian tempat tidak tersedia. Cuba lagi apabila dalam talian."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поиск мест недоступен. Повторите попытку при подключении к сети."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yer araması kullanılamıyor. İnternete bağlandığınızda tekrar deneyin."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جگہ کی تلاش دستیاب نہیں۔ آن لائن ہونے پر دوبارہ کوشش کریں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地点搜索不可用。请联网后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地點搜尋無法使用。請連線後再試。"
          }
        }
      }
    },
    "Place the phone screen-up, with the front camera just behind your mouth’s position during sujood, so your face covers it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضع الهاتف والشاشة للأعلى، بحيث تكون الكاميرا الأمامية خلف موضع فمك قليلًا أثناء السجود ليغطيها وجهك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege das Telefon mit dem Bildschirm nach oben hin. Die Frontkamera liegt bei der Niederwerfung knapp hinter der Position deines Mundes, sodass dein Gesicht sie bedeckt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Place the phone screen-up, with the front camera just behind your mouth’s position during sujood, so your face covers it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloca el teléfono con la pantalla hacia arriba y la cámara frontal justo detrás de donde estará tu boca durante la postración, para que tu cara la cubra."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "گوشی را با صفحه رو به بالا قرار دهید، طوری که دوربین جلو کمی پشت محل دهان شما هنگام سجده باشد و صورتتان آن را بپوشاند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posez le téléphone écran vers le haut, avec la caméra avant juste derrière la position de votre bouche lors de la prosternation, afin que votre visage la recouvre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letakkan ponsel dengan layar menghadap ke atas, dengan kamera depan tepat di belakang posisi mulut saat sujud agar wajah menutupinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posiziona il telefono con lo schermo verso l’alto e la fotocamera anteriore appena dietro la posizione della bocca durante la prostrazione, affinché il viso la copra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面を上にして電話を置き、サジダの際に口が来る位置の少し手前に前面カメラが来るようにして、顔でカメラを覆ってください。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letakkan telefon dengan skrin menghadap ke atas, dengan kamera hadapan tepat di belakang kedudukan mulut semasa sujud supaya wajah menutupinya."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Положите телефон экраном вверх так, чтобы передняя камера находилась чуть позади положения рта при земном поклоне и лицо закрывало её."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefonu ekranı yukarı bakacak şekilde, ön kamera secde sırasında ağzınızın bulunduğu yerin hemen gerisinde kalacak ve yüzünüz kamerayı örtecek biçimde yerleştirin."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فون کو اسکرین اوپر کی طرف رکھیں، سامنے والا کیمرہ سجدے کے دوران آپ کے منہ کی جگہ سے ذرا پیچھے ہو تاکہ چہرہ اسے ڈھانپ لے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将手机屏幕朝上放置，让前置相机位于叩头时嘴部位置稍后方，以便脸部遮住相机。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將手機螢幕朝上放置，讓前置相機位於叩頭時嘴部位置稍後方，以便臉部遮住相機。"
          }
        }
      }
    },
