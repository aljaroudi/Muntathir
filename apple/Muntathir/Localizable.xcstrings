    "Notifications are disabled. Enable them in system Settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التنبيهات معطلة. فعّلها في إعدادات النظام."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benachrichtigungen sind deaktiviert. Aktiviere sie in den Systemeinstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifications are disabled. Enable them in system Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las notificaciones están desactivadas. Actívalas en los ajustes del sistema."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعلان‌ها غیرفعال‌اند. آن‌ها را در تنظیمات سیستم فعال کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les notifications sont désactivées. Activez-les dans les réglages système."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifikasi dinonaktifkan. Aktifkan di Pengaturan sistem."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le notifiche sono disabilitate. Abilitale nelle impostazioni di sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知が無効です。システム設定で有効にしてください。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemberitahuan dinyahdayakan. Dayakannya dalam Seting sistem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уведомления отключены. Включите их в системных настройках."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildirimler kapalı. Sistem Ayarları’ndan etkinleştirin."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اطلاعات بند ہیں۔ نظام کی ترتیبات میں فعال کریں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
