    "Month starts must preserve 29 or 30 day months." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب أن تحافظ بدايات الشهور على طول ٢٩ أو ٣٠ يومًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Monatsanfänge müssen Monate mit 29 oder 30 Tagen erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Month starts must preserve 29 or 30 day months."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los inicios de mes deben mantener meses de 29 o 30 días."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آغاز ماه‌ها باید طول هر ماه را ۲۹ یا ۳۰ روز نگه دارد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les débuts de mois doivent conserver des mois de 29 ou 30 jours."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Awal bulan harus mempertahankan panjang bulan 29 atau 30 hari."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli inizi dei mesi devono mantenere mesi di 29 o 30 giorni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各月が29日または30日になるように月初を設定してください。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permulaan bulan mesti mengekalkan bulan sepanjang 29 atau 30 hari."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начала месяцев должны сохранять длительность каждого месяца в 29 или 30 дней."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
