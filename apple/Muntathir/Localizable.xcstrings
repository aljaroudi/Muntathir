          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択した礼拝の通知を有効にします。リマインダーは設定から変更できます。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
