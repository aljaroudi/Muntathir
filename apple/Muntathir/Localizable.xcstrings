    "Keep the camera uncovered in steady light while it calibrates." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اترك الكاميرا مكشوفة في إضاءة ثابتة أثناء المعايرة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass die Kamera während der Kalibrierung bei gleichmäßigem Licht unbedeckt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the camera uncovered in steady light while it calibrates."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén la cámara descubierta con luz estable mientras se calibra."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هنگام کالیبراسیون، دوربین را در نور ثابت و بدون پوشش نگه دارید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez la caméra découverte sous une lumière stable pendant son étalonnage."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biarkan kamera tidak tertutup dalam cahaya stabil selama kalibrasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lascia la fotocamera scoperta con luce stabile durante la calibrazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "調整中は、安定した明るさの場所でカメラを覆わないでください。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biarkan kamera tidak ditutup dalam cahaya yang stabil semasa penentukuran."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Во время калибровки не закрывайте камеру и обеспечьте постоянное освещение."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalibrasyon sırasında kamerayı sabit ışıkta açıkta bırakın."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کیلیبریشن کے دوران کیمرے کو یکساں روشنی میں کھلا رکھیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "校准时请保持光线稳定，不要遮挡相机。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "校準時請保持光線穩定，不要遮擋相機。"
          }
        }
      }
    },
    "Keep the phone still in steady light, then try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ثبّت الهاتف في إضاءة مستقرة، ثم حاول مجددًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte das Telefon bei gleichmäßiger Beleuchtung still und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the phone still in steady light, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén el teléfono quieto con luz estable y vuelve a intentarlo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "گوشی را در نور ثابت بی‌حرکت نگه دارید، سپس دوباره تلاش کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez le téléphone immobile sous une lumière stable, puis réessayez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaga ponsel tetap diam dalam pencahayaan stabil, lalu coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni il telefono fermo con luce stabile, poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安定した明るさの場所で端末を動かさずに、もう一度お試しください。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pastikan telefon tidak bergerak dalam cahaya yang stabil, kemudian cuba lagi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Держите телефон неподвижно при ровном освещении и повторите попытку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefonu sabit ışıkta hareketsiz tutun, ardından tekrar deneyin."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مستقل روشنی میں فون کو ساکن رکھیں، پھر دوبارہ کوشش کریں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在稳定光线下保持手机静止，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在穩定光線下保持手機靜止，然後重試。"
          }
        }
