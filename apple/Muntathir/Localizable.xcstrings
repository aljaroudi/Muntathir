    "Enable notifications for your selected prayers. You can adjust reminders in Settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فعّل الإشعارات للصلوات التي اخترتها. يمكنك تعديل التذكيرات في الإعدادات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere Benachrichtigungen für deine gewählten Gebete. Erinnerungen kannst du in den Einstellungen anpassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enable notifications for your selected prayers. You can adjust reminders in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa las notificaciones de tus oraciones seleccionadas. Puedes ajustar los recordatorios en Ajustes."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعلان نمازهای انتخابی را فعال کنید. یادآوری‌ها را می‌توانید در تنظیمات تغییر دهید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez les notifications des prières choisies. Vous pouvez modifier les rappels dans Réglages."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktifkan notifikasi untuk salat yang dipilih. Anda dapat menyesuaikan pengingat di Pengaturan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abilita le notifiche per le preghiere scelte. Puoi modificare i promemoria in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択した礼拝の通知を有効にします。リマインダーは設定から変更できます。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dayakan pemberitahuan untuk solat pilihan anda. Anda boleh melaraskan peringatan dalam Seting."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите уведомления для выбранных намазов. Напоминания можно изменить в настройках."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçtiğiniz namazlar için bildirimleri etkinleştirin. Hatırlatmaları Ayarlar’dan değiştirebilirsiniz."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "منتخب نمازوں کی اطلاعات فعال کریں۔ یاد دہانیاں ترتیبات میں بدل سکتے ہیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为所选礼拜启用通知。您可以在设置中调整提醒。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為所選禮拜啟用通知。您可以在設定中調整提醒。"
          }
        }
      }
    },
