    "Press and hold a prayer time to mute its alert. Optional times can also be hidden." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط مطولًا على وقت الصلاة لكتم تنبيهه. يمكنك أيضًا إخفاء الأوقات الاختيارية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte eine Gebetszeit gedrückt, um ihre Benachrichtigung stummzuschalten. Optionale Zeiten lassen sich auch ausblenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press and hold a prayer time to mute its alert. Optional times can also be hidden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsada una hora de oración para silenciar su aviso. También puedes ocultar los horarios opcionales."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای بی‌صدا کردن هشدار، زمان نماز را نگه دارید. زمان‌های اختیاری را نیز می‌توان پنهان کرد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez un horaire de prière appuyé pour couper son alerte. Les horaires facultatifs peuvent aussi être masqués."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekan lama waktu salat untuk membisukan pengingatnya. Waktu opsional juga dapat disembunyikan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto un orario di preghiera per silenziarne l’avviso. Puoi anche nascondere gli orari facoltativi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "礼拝時刻を長押しすると通知をミュートできます。任意の時刻は非表示にもできます。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekan dan tahan waktu solat untuk membisukan maklumannya. Waktu pilihan juga boleh disembunyikan."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите и удерживайте время молитвы, чтобы отключить её уведомление. Необязательные времена можно также скрыть."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildirimini sessize almak için namaz vaktine basılı tutun. İsteğe bağlı vakitler de gizlenebilir."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اطلاع خاموش کرنے کے لیے نماز کے وقت کو دبا کر رکھیں۔ اختیاری اوقات کو چھپایا بھی جا سکتا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "长按礼拜时间可将其提醒静音。也可以隐藏可选时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長按禮拜時間可將其提醒靜音。也可以隱藏選用時間。"
          }
        }
      }
    },
