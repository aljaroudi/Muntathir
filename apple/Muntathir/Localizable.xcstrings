    "Future dates are estimates until the month’s moonsighting is confirmed or the month begins." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التواريخ المستقبلية تقديرية حتى تثبت رؤية هلال الشهر أو يبدأ الشهر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zukünftige Daten sind Schätzungen, bis die Mondsichtung für den Monat bestätigt ist oder der Monat beginnt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Future dates are estimates until the month’s moonsighting is confirmed or the month begins."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fechas futuras son estimaciones hasta que se confirme el avistamiento lunar del mes o comience el mes."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تاریخ‌های آینده تخمینی هستند تا رؤیت هلال ماه تأیید شود یا ماه آغاز شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les dates futures sont estimatives jusqu’à la confirmation de l’observation du croissant lunaire ou au début du mois."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanggal mendatang adalah perkiraan sampai rukyat hilal bulan tersebut dikonfirmasi atau bulan tersebut dimulai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le date future sono stime finché non viene confermato l’avvistamento lunare del mese o il mese ha inizio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将来の日付は、その月の新月の目視が確認されるか、その月が始まるまでは推定です。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarikh akan datang ialah anggaran sehingga cerapan anak bulan disahkan atau bulan tersebut bermula."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будущие даты являются приблизительными до подтверждения наблюдения лунного серпа или начала месяца."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gelecekteki tarihler, ayın hilal gözlemi doğrulanana veya ay başlayana kadar tahminidir."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مستقبل کی تاریخیں تخمینی ہیں، جب تک اس مہینے کی رؤیتِ ہلال کی تصدیق نہ ہو جائے یا مہینہ شروع نہ ہو جائے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未来日期为估计日期，直到该月的新月观测得到确认或该月开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未來日期為估計日期，直到該月的新月觀測獲得確認或該月開始。"
          }
        }
      }
    },
