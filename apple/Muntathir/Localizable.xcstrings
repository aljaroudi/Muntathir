    "Without a published announcement, dates use the system calendar. Adjust individual months in Calendar." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند عدم وجود إعلان منشور، تتبع التواريخ تقويم النظام. يمكنك تعديل كل شهر على حدة في التقويم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne veröffentlichte Bekanntgabe gilt der Systemkalender. Passe einzelne Monate im Kalender an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without a published announcement, dates use the system calendar. Adjust individual months in Calendar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin un anuncio publicado, las fechas usan el calendario del sistema. Ajusta cada mes en Calendario."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بدون اطلاعیهٔ منتشرشده، تاریخ‌ها از تقویم سیستم پیروی می‌کنند. ماه‌ها را جداگانه در تقویم تنظیم کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans annonce publiée, les dates suivent le calendrier système. Ajustez chaque mois dans Calendrier."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanpa pengumuman yang diterbitkan, tanggal mengikuti kalender sistem. Sesuaikan tiap bulan di Kalender."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza un annuncio pubblicato, le date seguono il calendario di sistema. Regola i singoli mesi in Calendario."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanpa pengumuman diterbitkan, tarikh mengikut kalendar sistem. Laraskan setiap bulan dalam Kalendar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без опубликованного объявления даты следуют системному календарю. Корректируйте отдельные месяцы в календаре."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yayımlanmış duyuru yoksa tarihler sistem takvimini kullanır. Takvim’de ayları ayrı ayrı ayarlayın."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شائع شدہ اعلان نہ ہو تو تاریخیں نظام کی تقویم کے مطابق ہوتی ہیں۔ تقویم میں ہر مہینہ الگ درست کریں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
