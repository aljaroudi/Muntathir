    "Restoring a book downloads the full library temporarily. Only your selected books are kept." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتطلب استعادة كتاب تنزيل المكتبة كاملة مؤقتًا. يُحتفظ فقط بالكتب التي اخترتها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Wiederherstellen eines Buches wird vorübergehend die gesamte Bibliothek heruntergeladen. Nur deine ausgewählten Bücher bleiben gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restoring a book downloads the full library temporarily. Only your selected books are kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al restaurar un libro se descarga temporalmente toda la biblioteca. Solo se conservan los libros seleccionados."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای بازیابی یک کتاب، کل کتابخانه موقتاً بارگیری می‌شود. فقط کتاب‌های انتخابی شما نگه داشته می‌شوند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La restauration d’un livre télécharge temporairement toute la bibliothèque. Seuls les livres sélectionnés sont conservés."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memulihkan buku akan mengunduh seluruh pustaka untuk sementara. Hanya buku pilihan Anda yang disimpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ripristino di un libro scarica temporaneamente l’intera biblioteca. Vengono conservati solo i libri selezionati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "書籍を復元する際は、一時的にライブラリ全体をダウンロードします。選択した書籍のみが保存されます。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memulihkan buku memuat turun seluruh perpustakaan buat sementara waktu. Hanya buku pilihan anda disimpan."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для восстановления книги временно загружается вся библиотека. Сохраняются только выбранные книги."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir kitabı geri yüklemek için tüm kütüphane geçici olarak indirilir. Yalnızca seçtiğiniz kitaplar saklanır."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کتاب بحال کرنے کے لیے پوری لائبریری عارضی طور پر ڈاؤن لوڈ ہوتی ہے۔ صرف آپ کی منتخب کتابیں رکھی جاتی ہیں۔"
          }
        },
