    "Twelver Shia convention. Historical dates may differ between sources." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twelver Shia convention. Historical dates may differ between sources."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وفق المذهب الشيعي الاثني عشري. قد تختلف التواريخ التاريخية بين المصادر."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convention chiite duodécimaine. Les dates historiques peuvent varier selon les sources."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwölfer-schiitische Konvention. Historische Daten können je nach Quelle abweichen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengikuti tradisi Syiah Dua Belas Imam. Tanggal sejarah dapat berbeda antar sumber."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convenzione sciita duodecimana. Le date storiche possono variare secondo le fonti."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengikut tradisi Syiah Dua Belas Imam. Tarikh sejarah mungkin berbeza mengikut sumber."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مطابق سنت شیعهٔ دوازده‌امامی. تاریخ‌های تاریخی ممکن است در منابع متفاوت باشند."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Традиция шиитов-двунадесятников. Исторические даты могут различаться в зависимости от источника."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convención chií duodecimana. Las fechas históricas pueden variar según las fuentes."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On İki İmam Şiiliği geleneği. Tarihî tarihler kaynaklara göre değişebilir."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اثنا عشری شیعہ روایت کے مطابق۔ تاریخی تاریخیں مختلف ماخذ میں مختلف ہو سکتی ہیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遵循十二伊玛目什叶派传统。历史日期可能因来源而异。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遵循十二伊瑪目什葉派傳統。歷史日期可能因來源而異。"
          }
        }
      },
      "extractionState" : "manual"
    },
    "Twelver Shia convention. Historical dates may differ between sources. [Event references](https://al-islam.org/islam-faith-practice-history-sayyid-muhammad-rizvi/lesson-17-twelve-caliphs-or-imams)." : {
