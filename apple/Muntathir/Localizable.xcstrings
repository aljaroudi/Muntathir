          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imsak adalah tindakan kehati-hatian sebelum waktu Subuh yang dihitung."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’Imsak è una precauzione prima del Fajr calcolato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "イムサークは、計算上のファジュル前に設ける予防的な時間です。"
