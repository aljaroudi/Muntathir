    "Choose the calculation method you follow. You can change it later in Settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر طريقة الحساب التي تتبعها. يمكنك تغييرها لاحقًا في الإعدادات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle deine Berechnungsmethode. Du kannst sie später in den Einstellungen ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose the calculation method you follow. You can change it later in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige tu método de cálculo. Puedes cambiarlo después en Ajustes."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "روش محاسبهٔ مورد نظر را انتخاب کنید. بعداً می‌توانید آن را در تنظیمات تغییر دهید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez votre méthode de calcul. Vous pourrez la modifier dans Réglages."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih metode perhitungan yang Anda ikuti. Anda dapat mengubahnya nanti di Pengaturan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli il tuo metodo di calcolo. Potrai cambiarlo in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "従う計算方式を選択してください。後で設定から変更できます。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih kaedah pengiraan yang anda ikuti. Anda boleh mengubahnya kemudian dalam Seting."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите принятый вами метод расчёта. Его можно изменить позже в настройках."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takip ettiğiniz hesaplama yöntemini seçin. Daha sonra Ayarlar’dan değiştirebilirsiniz."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اپنا طریقۂ حساب منتخب کریں۔ بعد میں ترتیبات میں اسے بدل سکتے ہیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择您遵循的计算方法。稍后可在设置中更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇您遵循的計算方法。稍後可在設定中更改。"
          }
        }
