        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ترتیب بدلنے کے لیے رنگوں کو گھسیٹیں۔ ابتدائی رنگ انتخاب میں دکھائی دیتے ہیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动颜色以调整顺序。列表开头的颜色将显示在选色器中。"
