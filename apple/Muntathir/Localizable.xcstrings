    "Silent reminders at sunset for observances beginning this evening." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تذكيرات صامتة عند غروب الشمس بالمناسبات التي تبدأ هذا المساء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stille Erinnerungen bei Sonnenuntergang an Gedenktage, die heute Abend beginnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silent reminders at sunset for observances beginning this evening."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recordatorios silenciosos al atardecer para las conmemoraciones que comienzan esta tarde."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یادآوری‌های بی‌صدا هنگام غروب برای مناسبت‌هایی که امشب آغاز می‌شوند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rappels silencieux au coucher du soleil pour les commémorations commençant ce soir."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengingat senyap saat matahari terbenam untuk peringatan yang dimulai malam ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Promemoria silenziosi al tramonto per le ricorrenze che iniziano questa sera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今晩始まる行事について、日没時に音なしで通知します。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peringatan senyap ketika matahari terbenam untuk peristiwa yang bermula malam ini."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Беззвучные напоминания на закате о памятных датах, начинающихся сегодня вечером."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu akşam başlayan anmalar için gün batımında sessiz hatırlatmalar."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آج شام شروع ہونے والی مناسبتوں کے لیے غروب آفتاب پر خاموش یاددہانیاں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日落时静音提醒今晚开始的纪念日。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日落時靜音提醒今晚開始的紀念日。"
          }
        }
      }
    },
