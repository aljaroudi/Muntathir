    "Positive values advance the Hijri date. Every month remains 29 or 30 days. Prayer times are unchanged." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "القيم الموجبة تقدّم التاريخ الهجري. يبقى كل شهر ٢٩ أو ٣٠ يومًا. لا تتغير أوقات الصلاة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Positive Werte stellen das Hidschri-Datum vor. Jeder Monat behält 29 oder 30 Tage. Gebetszeiten bleiben unverändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Positive values advance the Hijri date. Every month remains 29 or 30 days. Prayer times are unchanged."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los valores positivos adelantan la fecha hiyri. Cada mes mantiene 29 o 30 días. Los horarios de oración no cambian."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مقادیر مثبت تاریخ هجری را جلو می‌برند. هر ماه ۲۹ یا ۳۰ روز می‌ماند. اوقات نماز تغییر نمی‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les valeurs positives avancent la date hégirienne. Chaque mois garde 29 ou 30 jours. Les horaires de prière restent inchangés."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nilai positif memajukan tanggal Hijriah. Setiap bulan tetap 29 atau 30 hari. Waktu salat tidak berubah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I valori positivi anticipano la data egiriana. Ogni mese mantiene 29 o 30 giorni. Gli orari di preghiera non cambiano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正の値はヒジュラ暦の日付を進めます。各月は29日または30日を維持します。礼拝時刻は変わりません。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nilai positif mendahulukan tarikh Hijrah. Setiap bulan kekal 29 atau 30 hari. Waktu solat tidak berubah."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Положительные значения сдвигают дату хиджры вперёд. Каждый месяц остаётся длиной 29 или 30 дней. Время намаза не меняется."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozitif değerler hicri tarihi ileri alır. Her ay 29 veya 30 gün kalır. Namaz vakitleri değişmez."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مثبت مقدار ہجری تاریخ آگے کرتی ہے۔ ہر مہینہ ۲۹ یا ۳۰ دن کا رہتا ہے۔ نماز کے اوقات نہیں بدلتے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正值使伊斯兰历日期提前。每月仍为 29 或 30 天。礼拜时间不变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正值使伊斯蘭曆日期提前。每月仍為 29 或 30 天。禮拜時間不變。"
          }
        }
      }
    },
