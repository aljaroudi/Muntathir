          "stringUnit" : {
            "state" : "translated",
            "value" : "Los inicios de mes deben mantener meses de 29 o 30 días."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آغاز ماه‌ها باید طول هر ماه را ۲۹ یا ۳۰ روز نگه دارد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les débuts de mois doivent conserver des mois de 29 ou 30 jours."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Awal bulan harus mempertahankan panjang bulan 29 atau 30 hari."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli inizi dei mesi devono mantenere mesi di 29 o 30 giorni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各月が29日または30日になるように月初を設定してください。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permulaan bulan mesti mengekalkan bulan sepanjang 29 atau 30 hari."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начала месяцев должны сохранять длительность каждого месяца в 29 или 30 дней."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ay başlangıçları, ayların 29 veya 30 gün olmasını korumalıdır."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مہینوں کی ابتدا ایسی ہو کہ ہر مہینہ ۲۹ یا ۳۰ دن کا رہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "月份起始日期必须确保每月为 29 或 30 天。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "月份起始日期必須確保每月為 29 或 30 天。"
          }
        }
      }
    },
