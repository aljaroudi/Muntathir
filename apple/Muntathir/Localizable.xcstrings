    "You can download it again later. Quran will remain available." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك تنزيله مجددًا لاحقًا. سيبقى القرآن متاحًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst ihn später erneut herunterladen. Der Koran bleibt verfügbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can download it again later. Quran will remain available."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podrás descargarla de nuevo más tarde. El Corán seguirá disponible."
