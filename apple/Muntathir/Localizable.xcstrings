    "Without a published announcement, dates use the system calendar. Adjust individual months in Month adjustments." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند عدم وجود إعلان منشور، تتبع التواريخ تقويم النظام."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne veröffentlichte Bekanntgabe gilt der Systemkalender."
          }
