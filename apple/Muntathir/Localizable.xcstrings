          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktifkan notifikasi untuk salat yang dipilih. Anda dapat menyesuaikan pengingat di Pengaturan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
