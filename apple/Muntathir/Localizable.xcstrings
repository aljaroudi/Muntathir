    "Open Muntathir on your iPhone to sync your location and settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتح منتظِر على iPhone لمزامنة موقعك وإعداداتك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne Muntathir auf deinem iPhone, um Standort und Einstellungen zu synchronisieren."
          }
