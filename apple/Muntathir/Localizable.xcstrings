    "Could not find your location. Search for a city instead." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر العثور على موقعك. ابحث عن مدينة بدلًا من ذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Standort wurde nicht gefunden. Suche stattdessen nach einer Stadt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not find your location. Search for a city instead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo encontrar tu ubicación. Busca una ciudad."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مکان شما پیدا نشد. به‌جای آن شهری را جست‌وجو کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Position introuvable. Recherchez plutôt une ville."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokasi Anda tidak ditemukan. Cari kota sebagai gantinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile trovare la tua posizione. Cerca una città."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在地が見つかりませんでした。代わりに都市を検索してください。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokasi anda tidak dapat ditemui. Cari bandar sebagai ganti."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось определить геопозицию. Попробуйте найти город."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konumunuz bulunamadı. Bunun yerine bir şehir arayın."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کا مقام نہیں ملا۔ اس کے بجائے شہر تلاش کریں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法找到您的位置。请改为搜索城市。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找不到您的位置。請改為搜尋城市。"
          }
        }
      }
    },
    "Could not get a precise current location. Try again outdoors." : {
      "localizations" : {
