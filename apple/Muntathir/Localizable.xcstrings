    "Alerts are scheduled for up to 10 days. Open the app regularly to refresh them." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُجدول التنبيهات لمدة تصل إلى ١٠ أيام. افتح التطبيق بانتظام لتحديثها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinweise werden für bis zu 10 Tage geplant. Öffne die App regelmäßig, um sie zu aktualisieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alerts are scheduled for up to 10 days. Open the app regularly to refresh them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las alertas se programan para un máximo de 10 días. Abre la app regularmente para actualizarlas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یادآوری‌ها حداکثر برای ۱۰ روز زمان‌بندی می‌شوند. برای به‌روزرسانی، برنامه را مرتب باز کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les alertes sont programmées pour 10 jours maximum. Ouvrez régulièrement l’app pour les actualiser."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengingat dijadwalkan hingga 10 hari. Buka aplikasi secara berkala untuk memperbaruinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli avvisi sono programmati per un massimo di 10 giorni. Apri regolarmente l’app per aggiornarli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知は最大10日先まで設定されます。定期的にAppを開いて更新してください。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peringatan dijadualkan sehingga 10 hari. Buka aplikasi secara berkala untuk mengemas kininya."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уведомления планируются на срок до 10 дней. Регулярно открывайте приложение для их обновления."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hatırlatmalar en fazla 10 gün için planlanır. Yenilemek için uygulamayı düzenli olarak açın."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یاد دہانیاں زیادہ سے زیادہ ۱۰ دن کے لیے مقرر ہوتی ہیں۔ تازہ کرنے کے لیے ایپ باقاعدگی سے کھولیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提醒最多安排未来 10 天。请定期打开 App 以更新提醒。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提醒最多排定未來 10 天。請定期打開 App 以更新提醒。"
          }
        }
      }
    },
    "Alerts follow published month announcements after a successful refresh; delivery is not immediate." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتبع التنبيهات إعلانات الأشهر المنشورة بعد تحديث ناجح؛ ولا تصل فورًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinweise folgen veröffentlichten Monatsbekanntgaben nach erfolgreicher Aktualisierung; die Zustellung erfolgt nicht sofort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alerts follow published month announcements after a successful refresh; delivery is not immediate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las alertas siguen los anuncios publicados tras una actualización correcta; la entrega no es inmediata."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعلان‌ها پس از به‌روزرسانی موفق، مطابق اطلاعیه‌های منتشرشدهٔ ماه ارسال می‌شوند؛ تحویل آنی نیست."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les alertes suivent les annonces publiées après une actualisation réussie ; leur réception n’est pas immédiate."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengingat mengikuti pengumuman bulan yang diterbitkan setelah pembaruan berhasil; pengiriman tidak seketika."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli avvisi seguono gli annunci pubblicati dopo un aggiornamento riuscito; la consegna non è immediata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更新が成功すると、公開された月の発表に従って通知されます。配信は即時ではありません。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peringatan mengikut pengumuman bulan yang diterbitkan selepas kemas kini berjaya; penghantaran tidak serta-merta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уведомления следуют опубликованным объявлениям после успешного обновления; доставка не мгновенная."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyarılar başarılı yenilemenin ardından yayımlanan ay duyurularını izler; teslimat anlık değildir."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کامیاب تازہ کاری کے بعد شائع شدہ اعلانات کے مطابق اطلاعات آتی ہیں؛ ترسیل فوری نہیں ہوتی۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "成功刷新后，提醒将依据已发布的月份公告发送；不会即时送达。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "成功重新整理後，提醒將依據已發佈的月份公告傳送；不會即時送達。"
          }
        }
      }
    },
