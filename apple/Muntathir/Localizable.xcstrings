            "state" : "translated",
            "value" : "Faites glisser les couleurs pour les réorganiser. Les premières apparaissent dans le sélecteur."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seret warna untuk mengubah urutannya. Warna teratas muncul di pemilih."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina i colori per riordinarli. I primi colori appaiono nel selettore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "色をドラッグして並べ替えます。先頭の色から選択画面に表示されます。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seret warna untuk menyusun semula. Warna teratas muncul dalam pemilih."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетаскивайте цвета, чтобы изменить порядок. Первые цвета появятся в палитре."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renkleri sürükleyerek sıralayın. İlk renkler seçicide görünür."
          }
