    "Choose a city or use your device location to calculate prayer times and Qibla." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر مدينة أو استخدم موقع جهازك لحساب أوقات الصلاة واتجاه القبلة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle eine Stadt oder verwende den Gerätestandort, um Gebetszeiten und Qibla zu berechnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a city or use your device location to calculate prayer times and Qibla."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige una ciudad o usa la ubicación del dispositivo para calcular los horarios de oración y la alquibla."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای محاسبهٔ اوقات نماز و قبله، شهری را انتخاب کنید یا از مکان دستگاه استفاده کنید."
          }
        },
        "fr" : {
