    "Increase the light and keep the camera uncovered, then try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "زِد الإضاءة واترك الكاميرا مكشوفة، ثم حاول مجددًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhöhe die Beleuchtung und halte die Kamera frei. Versuche es dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Increase the light and keep the camera uncovered, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aumenta la luz y deja la cámara descubierta. Luego inténtalo de nuevo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نور را بیشتر کنید و دوربین را نپوشانید، سپس دوباره تلاش کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Augmentez la lumière et laissez la caméra dégagée, puis réessayez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambah pencahayaan dan jangan tutupi kamera, lalu coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aumenta la luce e lascia la fotocamera scoperta, poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "明るくしてカメラを覆わずに、もう一度お試しください。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambah pencahayaan dan jangan tutup kamera, kemudian cuba lagi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усильте освещение и не закрывайте камеру, затем повторите попытку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Işığı artırın ve kamerayı açıkta tutun, ardından tekrar deneyin."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "روشنی بڑھائیں اور کیمرے کو کھلا رکھیں، پھر دوبارہ کوشش کریں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "增加光线并保持摄像头无遮挡，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "增加光線並保持相機鏡頭無遮擋，然後重試。"
          }
        }
      }
    },
