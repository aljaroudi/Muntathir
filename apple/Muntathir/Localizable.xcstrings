    "Numbers may repeat across chapters. Choose a matching reference." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد تتكرر الأرقام بين الأبواب. اختر المرجع المطابق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nummern können in mehreren Kapiteln vorkommen. Wählen Sie eine passende Fundstelle."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numbers may repeat across chapters. Choose a matching reference."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los números pueden repetirse entre capítulos. Elige una referencia coincidente."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ممکن است شماره‌ها در باب‌های مختلف تکرار شوند. مرجع مورد نظر را انتخاب کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les numéros peuvent se répéter entre les chapitres. Choisissez une référence correspondante."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nomor dapat berulang antar bab. Pilih rujukan yang sesuai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I numeri possono ripetersi tra i capitoli. Scegli un riferimento corrispondente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "番号は章ごとに重複する場合があります。一致する参照を選んでください。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nombor mungkin berulang antara bab. Pilih rujukan yang sepadan."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Номера могут повторяться в разных главах. Выберите нужную ссылку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numaralar bölümler arasında tekrarlanabilir. Eşleşen bir kaynak seçin."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مختلف ابواب میں نمبر دہرائے جا سکتے ہیں۔ متعلقہ حوالہ منتخب کریں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不同章节的编号可能重复。请选择匹配的出处。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不同章節的編號可能重複。請選擇相符的出處。"
          }
        }
      }
    },
