{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
      "ar",
      "de",
      "es",
      "fa",
      "fr",
      "id",
      "it",
      "ja",
      "ms",
      "ru",
      "tr",
      "ur",
      "zh-Hans",
      "zh-Hant",
    ],
  },
  "packages": [
    {
      "kind": "remote",
      "repository": "https://github.com/batoulapps/adhan-swift.git",
      "version": {
        "version": "1.5.0",
      },
    },
  ],
  "files": [
    {
      "path": "<PROJECT>/../shared/figures/figures.json",
      "target-membership": [
        "Muntathir/resources",
        "MuntathirTests/resources",
        "MuntathirUITests/resources",
      ],
    }, {
      "path": "<PROJECT>/../shared/events.json",
      "target-membership": [
        "MuntathirWidgets/resources",
        "Muntathir/resources",
      ],
    },
    { "path": "<PROJECT>/MuntathirAssetDownloader/AssetDownloader.swift", "target-membership": [ "MuntathirAssetDownloader/compile-sources" ] },
