    { "path": "<PROJECT>/Muntathir/Core/QuranTranslationFiles.swift", "target-membership": [ "MuntathirWidgets/compile-sources" ] },
    { "path": "<PROJECT>/Muntathir/Core/QuranTranslation.swift", "target-membership": [ "MuntathirWidgets/compile-sources" ] },
