            "aliMulla.wav",
            "alsarraf.wav",
          ],
        },
      ],
    }, {
      "path": "<PROJECT>/AppIcon.icon",
      "target-membership": [
        "MuntathirWatch/resources",
        "Muntathir/resources",
      ],
    }, {
      "kind": "group",
      "name": "Shared watch sources",
      "children": [
