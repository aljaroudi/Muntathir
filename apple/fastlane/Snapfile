project("./Muntathir.xcodeproj")
scheme("Muntathir")
configuration("Debug")
devices(["iPhone 17 Pro Max", "iPad Pro 13-inch (M5)"])
ios_version(ENV.fetch("SCREENSHOT_IOS_VERSION", "27.0"))
languages(["en-US", "ar-SA"])
only_testing(["MuntathirUITests/MarketingScreenshotTests"])
output_directory("./build/marketing/raw")
buildlog_path("./build/logs/snapshot")
derived_data_path("./build/DerivedData")
skip_open_summary(true)
concurrent_simulators(false)
xcargs("-parallel-testing-enabled NO")
number_of_retries(0)
stop_after_first_error(true)
clear_previous_screenshots(true)
reinstall_app(true)
app_identifier("com.aljaroudi.Muntathir")
override_status_bar(true)
override_status_bar_arguments("--time 9:41 --dataNetwork wifi --wifiMode active --wifiBars 3 --batteryState charged --batteryLevel 100")
