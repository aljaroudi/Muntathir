# Store the real file at ~/.config/muntathir/fastlane.env (chmod 600).
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=/absolute/path/to/AuthKey_KEYID.p8
# Optional screenshot runtime override. Install it in Xcode first.
SCREENSHOT_IOS_VERSION=27.0
# Optional JSON containing missing review/compliance fields; never commit personal details.
MUNTATHIR_REVIEW_CONFIG=/absolute/path/to/review.json
