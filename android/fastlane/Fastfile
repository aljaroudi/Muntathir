default_platform(:android)

platform :android do
  desc "Validate a signed AAB on Google Play or save it as an internal draft"
  lane :internal do |options|
    bundle = options[:aab].to_s
    credentials = ENV.fetch("SUPPLY_JSON_KEY", "")
    UI.user_error!("Pass the signed bundle as aab:/absolute/path/app-release.aab") unless
      File.file?(bundle) && File.extname(bundle) == ".aab"
    UI.user_error!("Set SUPPLY_JSON_KEY to a readable Google credentials JSON file") unless
      File.file?(credentials) && File.readable?(credentials)

    upload_to_play_store(
      package_name: "com.aljaroudi.muntathir",
      json_key: File.expand_path(credentials),
      aab: File.expand_path(bundle),
      track: "internal",
      release_status: "draft",
      validate_only: options[:draft] != true,
      skip_upload_apk: true,
      skip_upload_aab: false,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end
