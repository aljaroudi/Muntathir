<?xml version="1.0" encoding="utf-8"?>
<!-- Text in home screen widgets. Glance can't load app fonts, so widget text is a RemoteViews TextView
     (widgets/WidgetText.kt) whose layout carries the font and a color that follows dark mode. -->
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Widget.Muntathir.Text" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/ibm_plex_sans_arabic</item>
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textAlignment">viewStart</item>
    </style>

    <style name="Widget.Muntathir.Text.Strong">
        <!-- SemiBold on API 28+; Bold below, where only textStyle picks a weight. -->
        <item name="android:textStyle">bold</item>
        <item name="android:textFontWeight" tools:ignore="NewApi">600</item>
    </style>

    <style name="Widget.Muntathir.Text.Secondary">
        <item name="android:textColor">@color/widget_text_secondary</item>
    </style>

    <style name="Widget.Muntathir.Text.Quran">
        <item name="android:fontFamily">@font/qpc_hafs</item>
        <item name="android:textDirection">rtl</item>
        <item name="android:textAlignment">center</item>
        <item name="android:includeFontPadding">true</item>
    </style>
</resources>
