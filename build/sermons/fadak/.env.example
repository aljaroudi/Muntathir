# Default target language (ISO code or name, overridden by --lang / -l)
TARGET_LANG=en

# Vercel AI Gateway (@ai-sdk/gateway uses https://ai-gateway.vercel.sh/v4/ai automatically)
AI_GATEWAY_API_KEY=
# Per-request timeout in milliseconds (default: 1800000 = 30 min; SSE streaming keeps connections alive)
REQUEST_TIMEOUT_MS=1800000

# Frontier model slugs on Vercel AI Gateway (override if gateway uses different IDs)
MODEL_GEMINI=google/gemini-4-carbon
MODEL_GROK=spacexai/grok-4.7
MODEL_CLAUDE=anthropic/claude-opus-5.5
MODEL_GPT=openai/gpt-6.2-astra

# Google Cloud Translation API v3
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_TRANSLATE_ACCESS_TOKEN=

# Kagi baselines are supplied manually as data/kagi/<code>-kagi.md (no API key needed)
