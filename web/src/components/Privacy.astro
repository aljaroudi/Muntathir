---
import { Font } from "astro:assets";
import "@/styles/global.css";
import { site, type Locale } from "@/site";
interface Props { locale: Locale }
const { locale } = Astro.props;
const arabic = locale === "ar";
const title = arabic ? "سياسة الخصوصية" : "Privacy policy";
const paragraphs = arabic ? [
  "لا يتطلب منتظِر حسابًا، ولا يستخدم بياناتك للإعلانات أو التتبّع.",
  "تبقى تفضيلات القراءة والمفضلة والملاحظات على أجهزتك. تُزامَن الإعدادات وبيانات القرآن الشخصية عبر حساب iCloud الخاص بك عند تفعيله. تستخدم خدمات Apple، مثل الطقس والموقع والتنزيلات، البيانات اللازمة لتقديم الخدمة وفق سياسة خصوصية Apple.",
  "عند إرسال بحث في المكتبة العامة، يُرسل استعلامك إلى خدمة البحث لدينا التي تستخدم Google للعثور على النصوص ذات الصلة، وقد ترسل الاستعلام والنصوص المرشحة إلى خدمة Jev من Typesafe AI لترتيب النتائج. إذا تعذّر البحث عبر الإنترنت، يبحث التطبيق على جهازك. تنقل Cloudflare الطلب وتعالج معلومات الاتصال، ومنها عنوان IP. تخزّن خدمتنا تمثيلات الاستعلام الرقمية ونتائج البحث مؤقتًا، وتستخدم معرّفات مشتقة بالتجزئة من عناوين IP لتحديد معدل الطلبات، وتسجّل مقاييس تشغيلية دون نص الاستعلام الأصلي. لا تُرسل ملاحظات القراءة أو المفضلة مع البحث. تجنّب تضمين معلومات شخصية في استعلاماتك.",
  "إذا اخترت التواصل معنا عبر نموذج الدعم، فسنستخدم المعلومات التي ترسلها طوعًا للرد عليك فقط. تستضيف Google النموذج وفق سياسة خصوصيتها.",
] : [
  "Muntathir does not require an account and does not use your data for advertising or tracking.",
  "Reading preferences, favorites, and notes stay on your devices. Settings and personal Quran data sync through your own iCloud account when enabled. Apple services, including weather, location, and downloads, use the data needed to provide those services under Apple’s privacy policy.",
  "Submitting a public-library search sends your query to our search service, which uses Google to find relevant passages and may send the query and candidate passages to Typesafe AI’s Jev service for ranking. If online search is unavailable, the app searches on your device. Cloudflare carries the request and processes connection information, including your IP address. Our service temporarily caches query embeddings and search results, uses hashed IP identifiers for rate limits, and records operational metrics without raw query text. Your reading notes and favorites are not sent with searches. Avoid including personal information in search queries.",
  "If you contact us through the support form, we use the information you voluntarily submit only to reply. Google hosts the form under its privacy policy.",
];
const telegram = arabic ? [
  "بوت منتظِر وتطبيقه المصغّر في تيليجرام اختياريان، ويخضع استخدامهما لسياسة خصوصية تيليجرام أيضًا. تيليجرام يزوّدنا بمعرّف حسابك واسمك ولغتك وما ترسله إلى البوت. لا نحتفظ بقاعدة بيانات للمستخدمين، ولا نرسل رسائل مجدولة، ولا نستخدم بياناتك للإعلانات أو التتبّع.",
  "إذا شاركت موقعك مع البوت، نعالجه في الذاكرة للرد ولا نحفظه. تحمل أزرار الرد إحداثيات مقرّبة إلى نحو 110 أمتار، وتبقى مع رسائلك في محادثتك على تيليجرام إلى أن تحذفها. أما في التطبيق المصغّر فتُحسب أوقات الصلاة والقبلة على جهازك ولا يصل موقعك إلى خادمنا. يُحفظ الموقع وموضع القراءة على جهازك، وتُحفظ طريقة الحساب واللغة في التخزين السحابي لدى تيليجرام.",
  "يُرسل نص البحث من تيليجرام إلى خدمة البحث نفسها، وقد تعالجه Google وخدمة Jev كما هو موضح أعلاه، ولا يتوفر هنا بحث على الجهاز. نستخدم معرّفات مؤقتة مشتقة من معرّف حسابك لتحديد عدد الطلبات، وقد تحفظ خدمة البحث تجزئتها ونتائج البحث لمدة قصيرة. تنقل Cloudflare طلبات التطبيق المصغّر وتعالج عنوان IP. لا تتضمن سجلاتنا معرّفك أو موقعك أو نصوصك. لا نحتفظ ببيانات حساب يلزم حذفها، ويمكنك حذف المحادثة وإيقاف البوت من تيليجرام في أي وقت.",
] : [
  "Muntathir’s Telegram bot and Mini App are optional, and Telegram’s privacy policy also applies to them. Telegram gives us your account ID, name, language, and what you send the bot. We keep no user database, send no scheduled messages, and don’t use your data for advertising or tracking.",
  "If you share your location with the bot, we process it in memory to reply and don’t store it. Reply buttons carry coordinates rounded to about 110 m, and these stay with your messages in your Telegram chat until you delete them. In the Mini App, prayer times and Qibla are calculated on your device and your location never reaches our server. Location and reading position are saved on your device; calculation method and language are saved in Telegram’s cloud storage.",
  "Searches from Telegram go to the same search service and may be processed by Google and Jev as described above; there is no on-device search here. We use temporary identifiers derived from your account ID for rate limits, and the search service may briefly keep hashes of them along with cached results. Cloudflare carries Mini App requests and processes your IP address. Our logs contain no account IDs, locations, or text. We hold no account data to delete, and you can delete the chat and stop the bot in Telegram at any time.",
];
---
<!doctype html>
<html lang={locale} dir={arabic ? "rtl" : "ltr"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} · {arabic ? "منتظِر" : "Muntathir"}</title>
    <link rel="canonical" href={new URL(arabic ? "/privacy/" : "/en/privacy/", site)} />
    <Font cssVariable="--font-arabic" preload />
  </head>
  <body class="bg-ivory text-emerald antialiased">
    <main class="mx-auto max-w-2xl px-6 py-16">
      <a href={arabic ? "/" : "/en/"} class="underline">{arabic ? "منتظِر" : "Muntathir"}</a>
      <h1 class="my-8 text-3xl font-medium">{title}</h1>
      {paragraphs.map(text => <p class="my-5 leading-loose">{text}</p>)}
      <section id="telegram" aria-labelledby="telegram-title">
        <h2 id="telegram-title" class="mb-4 mt-10 text-xl font-medium">{arabic ? "تيليجرام" : "Telegram"}</h2>
        {telegram.map(text => <p class="my-5 leading-loose">{text}</p>)}
      </section>
      <nav class="mt-10 flex gap-6" aria-label={arabic ? "روابط" : "Links"}>
        <a class="underline" href="/support/">{arabic ? "الدعم" : "Support"}</a>
        <a class="underline" href={arabic ? "/en/privacy/" : "/privacy/"} lang={arabic ? "en" : "ar"}>{arabic ? "English" : "العربية"}</a>
      </nav>
    </main>
  </body>
</html>
