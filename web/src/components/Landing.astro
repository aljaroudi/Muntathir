---
import { Font } from "astro:assets";
import "../styles/global.css";
import { translations } from "../i18n";
import { appStore, site, paths, isPreview, type Locale } from "../site";
import Star from "./Star.astro";
import PhonePreview from "./PhonePreview.astro";
import Download from "./Download.astro";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = translations[locale];
const canonical = new URL(paths[locale], site).href;
const social = new URL(`/social/${locale}.png`, site).href;
const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Muntathir",
  alternateName: "منتظِر",
  description: t.description,
  url: canonical,
  operatingSystem: "iOS, iPadOS, watchOS",
  applicationCategory: "LifestyleApplication",
  inLanguage: ["ar", "en"],
  installUrl: appStore,
};
---

<!doctype html>
<html lang={locale} dir={locale === "ar" ? "rtl" : "ltr"}>
  <head>
    <meta charset="UTF-8" />
    <Font cssVariable="--font-arabic" preload />
    <Font cssVariable="--font-quran" preload />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f5ee" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    {isPreview && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ar" href={site.href} />
    <link rel="alternate" hreflang="en" href={new URL("/en/", site).href} />
    <link rel="alternate" hreflang="x-default" href={site.href} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Muntathir · منتظِر" />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === "ar" ? "ar_SA" : "en_US"} />
    <meta
      property="og:locale:alternate"
      content={locale === "ar" ? "en_US" : "ar_SA"}
    />
    <meta property="og:image" content={social} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.title} />
    <meta name="twitter:description" content={t.description} />
    <meta name="twitter:image" content={social} />
    <meta name="twitter:image:alt" content={t.title} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(schema).replace(/</g, "\\u003c")}
    />
  </head>
  <body id="top" class="bg-ivory text-emerald antialiased">
    <a class="fixed inset-s-3 top-3 z-50 -translate-y-24 rounded-lg bg-emerald px-5 py-3 text-white focus:translate-y-0" href="#main">{t.skip}</a>
    <header class="mx-auto flex max-w-5xl items-center justify-between gap-4 border-b border-emerald/15 px-5 py-6 sm:px-8">
      <a href={paths[locale]} class="flex items-center gap-3 text-xl font-semibold" aria-label={t.name}>
        <img src="/favicon.svg" width="38" height="38" alt="" class="rounded-xl" />{t.name}
      </a>
      <nav aria-label={t.nav.language} class="flex items-center gap-3 text-sm">
        <a href="/" lang="ar" hreflang="ar" class="rounded px-1 py-2 aria-[current=page]:underline underline-offset-8" aria-current={locale === "ar" ? "page" : undefined}>العربية</a>
        <span aria-hidden="true" class="text-emerald/35">/</span>
        <a href="/en/" lang="en" hreflang="en" class="rounded px-1 py-2 aria-[current=page]:underline underline-offset-8" aria-current={locale === "en" ? "page" : undefined}>English</a>
      </nav>
    </header>
    <main id="main" class="mx-auto max-w-5xl px-5 sm:px-8">
      <section class="grid items-center gap-12 py-14 sm:py-20 md:grid-cols-2 md:gap-16" aria-labelledby="hero-title">
        <div>
          <Star class="mb-6 size-8 text-gold" />
          <h1 id="hero-title" class="text-4xl leading-relaxed font-medium tracking-tight sm:text-5xl">{t.hero.first}<br /><span class="text-moss">{t.hero.second}</span></h1>
          <p class="my-5 max-w-md text-base leading-loose text-muted">{t.hero.text}</p>
          <Download label={t.hero.cta} />
        </div>
        <PhonePreview locale={locale} />
      </section>
      <section id="features" class="border-t border-emerald/15 py-12 sm:py-16" aria-labelledby="features-title">
        <h2 id="features-title" class="text-2xl font-medium">{t.features.title}</h2>
        <div class="mt-8 grid gap-x-12 gap-y-9 sm:grid-cols-2">
          {t.features.items.map(item => <article class="flex gap-4"><Star class="mt-1 size-5 text-gold" /><div><h3 class="text-lg font-medium">{item.title}</h3><p class="mt-2 text-sm leading-loose text-muted">{item.text}</p></div></article>)}
        </div>
        <p class="mt-10 rounded-2xl bg-[#e9eedf] px-6 py-5 text-sm leading-loose">{t.companions}</p>
      </section>
      <section id="questions" class="border-t border-emerald/15 py-12 sm:py-16" aria-labelledby="faq-title">
        <h2 id="faq-title" class="mb-6 text-2xl font-medium">{t.faq.title}</h2>
        <div class="divide-y divide-emerald/15">
          {t.faq.items.map(item => <details class="group"><summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-sm font-medium"><span>{item.q}</span><span aria-hidden="true" class="text-xl font-normal group-open:rotate-45">+</span></summary><p class="max-w-2xl pb-5 text-sm leading-loose text-muted">{item.a}</p></details>)}
        </div>
      </section>
      <section class="border-t border-emerald/15 py-12 sm:py-16" aria-labelledby="calendar-title">
        <h2 id="calendar-title" class="text-2xl font-medium">{t.calendar.title}</h2>
        <p class="mt-3 max-w-2xl text-sm leading-loose text-muted">{t.calendar.description}</p>
        <a class="mt-4 inline-flex min-h-11 items-center underline underline-offset-4" href={`webcal://${site.host}/calendar/${locale}.ics`}>{t.calendar.subscribe}</a>
      </section>
    </main>
    <footer class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-4 border-t border-emerald/15 px-5 py-7 text-xs text-muted sm:px-8">
      <span>© {new Date().getUTCFullYear()} {t.name}</span>
      <nav class="flex gap-5" aria-label={locale === "ar" ? "روابط" : "Links"}>
        <a href="/support/" class="inline-flex min-h-10 items-center">{locale === "ar" ? "الدعم" : "Support"}</a>
        <a href={locale === "ar" ? "/privacy/" : "/en/privacy/"} class="inline-flex min-h-10 items-center">{locale === "ar" ? "الخصوصية" : "Privacy"}</a>
      </nav>
      <a href="#top" class="inline-flex min-h-10 items-center gap-2">{t.footer.top}<span aria-hidden="true">↑</span></a>
    </footer>
  </body>
</html>
