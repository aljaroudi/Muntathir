---
import { Image } from "astro:assets";
import arabic from "../assets/today-ar.png";
import english from "../assets/today-en.png";
import type { Locale } from "../site";
interface Props { locale: Locale }
const { locale } = Astro.props;
---
<figure data-phone-preview class="mx-auto w-full max-w-[286px] px-2 py-5">
  <div class="perspective-distant">
    <div style={locale === "ar" ? "--phone-y: 13deg; --phone-z: -3deg; --edge-x: -1" : undefined} class="phone">
      <span aria-hidden="true" class="phone-button phone-button-action"></span>
      <span aria-hidden="true" class="phone-button phone-button-volume-up"></span>
      <span aria-hidden="true" class="phone-button phone-button-volume-down"></span>
      <span aria-hidden="true" class="phone-button phone-button-power"></span>
      <span aria-hidden="true" class="phone-button phone-button-camera"></span>
      <div class="phone-screen">
        <Image src={locale === "ar" ? arabic : english} widths={[286, 572, 858]} sizes="(max-width: 360px) 80vw, 286px" width={286} format="webp" loading="eager" fetchpriority="high" alt={locale === "ar" ? "شاشة اليوم في منتظِر: التاريخ الهجري ومواقيت الصلاة وآية اليوم" : "Muntathir Today screen with the Hijri date, prayer times, and daily ayah"} class="block h-auto w-full" />
        <span aria-hidden="true" class="phone-camera"><span></span></span>
        <div aria-hidden="true" class="phone-reflection"></div>
        <svg aria-hidden="true" class="phone-light" viewBox="0 0 300 650" preserveAspectRatio="none">
          <defs>
            <filter id={`glass-light-${locale}`} x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
              <feGaussianBlur in="SourceAlpha" stdDeviation="3" result="surface" />
              <feSpecularLighting in="surface" surfaceScale="5" specularConstant="0.45" specularExponent="35" lighting-color="#ffffff">
                <fePointLight data-glass-light x="30" y="60" z="220" />
              </feSpecularLighting>
              <feComposite in2="SourceAlpha" operator="in" />
            </filter>
          </defs>
          <rect x="1" y="1" width="298" height="648" rx="43" fill="white" filter={`url(#glass-light-${locale})`} />
        </svg>
      </div>
    </div>
  </div>
</figure>

<style>
  .phone {
    position: relative;
    direction: ltr;
    border-radius: 2.7rem;
    padding: 3px;
    background: linear-gradient(115deg, #e0e2e4, #aeb3b8 40%, #c7cbcf 75%, #e2e4e6);
    box-shadow: inset 0 0 0 1px #f2f3f4,
      calc(7px * var(--edge-x, 1)) 3px 0 #a7acb1,
      calc(18px * var(--edge-x, 1)) 25px 35px -12px #203f3538;
    transform-style: preserve-3d;
    transform: rotateX(calc(5deg + var(--scroll-tilt, 0deg) + var(--pointer-x, 0deg))) rotateY(calc(var(--phone-y, -13deg) + var(--pointer-y, 0deg))) rotateZ(var(--phone-z, 3deg));
    transition: transform 180ms ease-out;
  }
  .phone-screen {
    position: relative;
    overflow: hidden;
    border: 3px solid #101410;
    border-radius: 2.5rem;
    background: #101410;
    transform: translateZ(1px);
  }
  .phone-button {
    position: absolute;
    width: 2px;
    border-radius: 1px;
    background: #afb4b9;
    box-shadow: inset 0 0 0 0.5px #858b92;
  }
  .phone-button-action { left: -2px; top: 88px; height: 15px; }
  .phone-button-volume-up { left: -2px; top: 122px; height: 26px; }
  .phone-button-volume-down { left: -2px; top: 158px; height: 26px; }
  .phone-button-power { right: -2px; top: 132px; height: 43px; }
  .phone-button-camera { right: -2px; top: 355px; height: 27px; }
  .phone-camera {
    position: absolute;
    top: 7px;
    left: 50%;
    width: 72px;
    height: 19px;
    border-radius: 20px;
    transform: translateX(-50%);
    background: #080b09;
    box-shadow: inset 0 0 1px 1px #303832;
  }
  .phone-camera span {
    position: absolute;
    top: 6px;
    right: 8px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #36536b, #101c27 55%, #050906);
  }
  .phone-reflection, .phone-light {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .phone-reflection {
    background: radial-gradient(ellipse at var(--reflection-x, 35%) var(--reflection-y, 15%), #fff3, transparent 60%),
      linear-gradient(115deg, #ffffff18, transparent 35%, #ffffff08 48%, transparent 64%);
    mix-blend-mode: screen;
  }
  .phone-light { mix-blend-mode: screen; opacity: 0.65; }
  @media (prefers-reduced-motion: reduce) {
    .phone { transform: none; transition: none; }
  }
</style>

<script>
  import { phoneTilt } from "../phone-motion";

  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const mouse = window.matchMedia("(hover: hover) and (pointer: fine)");

  for (const preview of document.querySelectorAll<HTMLElement>("[data-phone-preview]")) {
    const phone = preview.querySelector<HTMLElement>(".phone");
    if (!phone) continue;
    const light = phone.querySelector<SVGFEPointLightElement>("[data-glass-light]");
    let pointer: { x: number; y: number } | undefined;
    let frame = 0;

    function update() {
      frame = 0;
      if (!phone) return;
      if (reducedMotion.matches) {
        phone.style.removeProperty("--scroll-tilt");
        phone.style.removeProperty("--pointer-x");
        phone.style.removeProperty("--pointer-y");
        phone.style.removeProperty("--reflection-x");
        phone.style.removeProperty("--reflection-y");
        light?.setAttribute("x", "30");
        light?.setAttribute("y", "60");
        return;
      }
      // Use the untransformed wrapper so tilt never changes its own measurements.
      const rect = preview.getBoundingClientRect();
      const tracking = pointer && mouse.matches && rect.bottom > 0 && rect.top < innerHeight;
      const tilt = phoneTilt(rect, innerWidth, innerHeight, tracking ? pointer : undefined);
      phone.style.setProperty("--scroll-tilt", `${tilt.scroll}deg`);
      phone.style.setProperty("--pointer-x", `${tilt.x}deg`);
      phone.style.setProperty("--pointer-y", `${tilt.y}deg`);
      phone.style.setProperty("--reflection-x", `${35 + tilt.y * 2}%`);
      phone.style.setProperty("--reflection-y", `${15 - tilt.x * 3}%`);
      light?.setAttribute("x", String(30 + tilt.y * 18));
      light?.setAttribute("y", String(60 - tilt.x * 24));
    }
    function schedule() {
      if (!frame) frame = requestAnimationFrame(update);
    }
    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", schedule, { passive: true });
    window.addEventListener("pointermove", event => {
      if (event.pointerType !== "mouse" || reducedMotion.matches || !mouse.matches) return;
      pointer = { x: event.clientX, y: event.clientY };
      schedule();
    }, { passive: true });
    function resetPointer() { pointer = undefined; schedule(); }
    document.documentElement.addEventListener("pointerleave", resetPointer);
    window.addEventListener("blur", resetPointer);
    reducedMotion.addEventListener("change", schedule);
    mouse.addEventListener("change", resetPointer);
    schedule();
  }
</script>
