---
import { translations } from "../i18n";
import type { Locale } from "../site";
import Star from "./Star.astro";
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = translations[locale];
---

<figure data-phone-preview class="min-w-0" aria-label={t.preview.label}>
  <div class="flex justify-center px-5 pt-5 pb-9 [perspective:1200px]">
    <div style={locale === "ar" ? "--phone-y: 13deg; --phone-z: -3deg; --edge-x: -1" : undefined} class="phone relative w-full max-w-[286px] rounded-[3.2rem] p-[7px]">
      <span aria-hidden="true" class="absolute -left-[3px] top-28 h-7 w-[3px] rounded-l bg-[#8c918c]"></span>
      <span aria-hidden="true" class="absolute -left-[3px] top-40 h-12 w-[3px] rounded-l bg-[#8c918c]"></span>
      <span aria-hidden="true" class="absolute -right-[3px] top-36 h-16 w-[3px] rounded-r bg-[#8c918c]"></span>
      <div class="relative overflow-hidden rounded-[2.8rem] border-[5px] border-[#141715] bg-ivory" dir={locale === "ar" ? "rtl" : "ltr"}>
        <div aria-hidden="true" dir="ltr" class="relative flex h-12 items-center justify-between px-6 text-[10px] font-semibold">
          <span>9:41</span>
          <span class="absolute top-2 left-1/2 h-[22px] w-[82px] -translate-x-1/2 rounded-full bg-[#101310]"><span class="absolute top-[7px] right-3 size-2 rounded-full bg-[#202d34] ring-1 ring-white/10"></span></span>
          <svg width="28" height="12" viewBox="0 0 28 12" fill="currentColor"><path d="M0 8h2v3H0zm4-3h2v6H4zm4-3h2v9H8z"/><rect x="14" y="2" width="11" height="8" rx="2" fill="none" stroke="currentColor"/><rect x="16" y="4" width="7" height="4" rx="1"/><path d="M26 5h2v2h-2z"/></svg>
        </div>
        <div class="px-4 pt-4 pb-8">
          <div class="mb-6 flex items-center justify-between"><span class="text-lg font-medium">{t.preview.today}</span><Star class="size-5 text-gold" /></div>
          <div class="rounded-2xl bg-emerald px-3 py-6 text-center text-ivory">
            <p class="text-[10px] text-[#e0e6d5]">{t.preview.verseLabel}</p>
            <p lang="ar" dir="rtl" class="quran my-5 text-[25px] leading-loose">{t.preview.verse}</p>
            <p class="text-[10px] text-[#e0e6d5]">{t.preview.reference}</p>
          </div>
          <ul class="mt-5 divide-y divide-emerald/10">
            {t.preview.prayers.map((prayer, i) => <li class="flex items-center justify-between py-4 text-xs"><span>{prayer}</span><bdi class="tabular-nums">{t.preview.times[i]}</bdi></li>)}
          </ul>
          <div aria-hidden="true" class="mt-5 flex items-center justify-around rounded-2xl bg-emerald/5 py-3 text-moss">
            <Star class="size-4" />
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 5h16v15H4zM4 10h16M8 3v4m8-4v4M8 14h2m4 0h2m-8 3h2"/></svg>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="9"/><path d="m15 9-2 4-4 2 2-4z"/></svg>
          </div>
        </div>
        <span aria-hidden="true" class="absolute bottom-2 left-1/2 h-1 w-24 -translate-x-1/2 rounded-full bg-emerald/75"></span>
        <div aria-hidden="true" class="pointer-events-none absolute inset-0 rounded-[2.4rem] bg-linear-to-br from-white/15 via-transparent to-transparent"></div>
      </div>
    </div>
  </div>
</figure>

<style>
  /* Layered metal and perspective need custom shadows; the screen uses Tailwind. */
  .phone {
    direction: ltr;
    background: linear-gradient(110deg, #d4d7d1, #646c65 18%, #dce0d9 49%, #9ba198 80%, #eef0eb);
    box-shadow: inset 0 0 0 1px #eef0e9, inset 0 0 0 3px #7b8279, calc(8px * var(--edge-x, 1)) 5px 0 #656d64, calc(10px * var(--edge-x, 1)) 6px 0 #afb5a9, calc(20px * var(--edge-x, 1)) 28px 35px -15px #203f3540;
    transform: rotateX(calc(5deg + var(--scroll-tilt, 0deg) + var(--pointer-x, 0deg))) rotateY(calc(var(--phone-y, -13deg) + var(--pointer-y, 0deg))) rotateZ(var(--phone-z, 3deg));
    transition: transform 180ms ease-out;
  }
  @media (prefers-reduced-motion: reduce) {
    .phone { transform: none; transition: none; }
  }
</style>

<script>
  import { phoneTilt } from "../phone-motion";

  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const mouse = window.matchMedia("(hover: hover) and (pointer: fine)");

  for (const preview of document.querySelectorAll<HTMLElement>("[data-phone-preview]")) {
    const phone = preview.querySelector<HTMLElement>(".phone");
    if (!phone) continue;
    let pointer: { x: number; y: number } | undefined;
    let frame = 0;

    function update() {
      frame = 0;
      if (!phone) return;
      if (reducedMotion.matches) {
        phone.style.removeProperty("--scroll-tilt");
        phone.style.removeProperty("--pointer-x");
        phone.style.removeProperty("--pointer-y");
        return;
      }
      // Use the untransformed wrapper so tilt never changes its own measurements.
      const rect = preview.getBoundingClientRect();
      const tracking = pointer && mouse.matches && rect.bottom > 0 && rect.top < innerHeight;
      const tilt = phoneTilt(rect, innerWidth, innerHeight, tracking ? pointer : undefined);
      phone.style.setProperty("--scroll-tilt", `${tilt.scroll}deg`);
      phone.style.setProperty("--pointer-x", `${tilt.x}deg`);
      phone.style.setProperty("--pointer-y", `${tilt.y}deg`);
    }
    function schedule() {
      if (!frame) frame = requestAnimationFrame(update);
    }
    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", schedule, { passive: true });
    window.addEventListener("pointermove", event => {
      if (event.pointerType !== "mouse" || reducedMotion.matches || !mouse.matches) return;
      pointer = { x: event.clientX, y: event.clientY };
      schedule();
    }, { passive: true });
    function resetPointer() { pointer = undefined; schedule(); }
    document.documentElement.addEventListener("pointerleave", resetPointer);
    window.addEventListener("blur", resetPointer);
    reducedMotion.addEventListener("change", schedule);
    mouse.addEventListener("change", resetPointer);
    schedule();
  }
</script>
